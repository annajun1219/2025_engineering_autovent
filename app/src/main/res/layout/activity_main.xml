<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    tools:context="com.example.autovent_2025.UI.main.MainActivity">

    <!-- 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="72dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 상단바 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_profile"
                    app:tint="#6B7280"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="영서님"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@id/ivProfile"
                    app:layout_constraintTop_toTopOf="@id/ivProfile"
                    app:layout_constraintBottom_toBottomOf="@id/ivProfile" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 날씨 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#5B4CF6"
                app:strokeWidth="0dp"
                app:cardUseCompatPadding="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19°"
                        android:textColor="@android:color/white"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvHiLo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="H:24°  L:18°"
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@id/tvTemp"
                        app:layout_constraintTop_toBottomOf="@id/tvTemp" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Montreal, Canada"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="@id/tvTemp"
                        app:layout_constraintTop_toBottomOf="@id/tvHiLo" />

                    <ImageView
                        android:id="@+id/ivCloud"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:src="@drawable/ic_cloud_rain"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@null" />

                    <TextView
                        android:id="@+id/tvWeatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mid Rain"
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2개 정보 카드 (강수량 / 대기질) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="#E9EEF7">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:minHeight="170dp">   <!-- 최소 높이 지정 -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="강수량"
                            android:textColor="#7A7F8A"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvRainMm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0mm"
                            android:textStyle="bold"
                            android:textSize="28sp"
                            android:textColor="#111827"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="오늘"
                            android:textColor="#7A7F8A"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>

                        <TextView
                            android:id="@+id/tvRainHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="현재시간 내로 8mm가\n예상됩니다."
                            android:textColor="#9AA0A6"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="#E9EEF7">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:minHeight="170dp">   <!-- 최소 높이 지정 -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="대기질"
                            android:textColor="#7A7F8A"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvAqi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="56"
                            android:textStyle="bold"
                            android:textSize="28sp"
                            android:textColor="#111827"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/tvAqiDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="보통"
                            android:textColor="#7A7F8A"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 진행/상태 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvProgressPct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50%"
                            android:textColor="#7A7F8A"
                            android:textSize="12sp"/>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress"
                            style="@style/Widget.Material3.LinearProgressIndicator"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            app:trackThickness="6dp"
                            app:indicatorDirectionLinear="startToEnd"
                            app:showAnimationBehavior="inward"
                            app:trackCornerRadius="6dp"
                            app:indicatorColor="#5B4CF6"
                            app:trackColor="#E5E7EB" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMainStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="현재 환기 대기중"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#111827"/>

                    <TextView
                        android:id="@+id/tvSubStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="다음 환기까지 2시간 45분 남았어요."
                        android:textSize="13sp"
                        android:textColor="#7A7F8A"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 모드 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:weightSum="2">

                <!-- 현재 모드 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="#E9EEF7">

                    <LinearLayout
                        android:layout_width="181dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:minHeight="170dp">   <!-- 최소 높이 지정 --><!-- 최소 높이 지정 -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="현재 모드 :"
                            android:textColor="#7A7F8A"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvCurrentMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="자동"
                            android:textColor="#111827"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 토글 카드 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:minHeight="170dp">   <!-- 최소 높이 지정 -->

                        <!-- 자동 모드 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="자동 모드"
                                android:textColor="#111827"
                                android:textSize="14sp"/>

                            <CheckBox
                                android:id="@+id/swAuto"
                                android:layout_width="56dp"
                                android:layout_height="32dp"
                                android:button="@null"
                                android:background="@drawable/switch_selector"
                                android:backgroundTint="@null"
                                android:padding="0dp"/>
                        </LinearLayout>

                        <!-- 미세먼지 모드 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="미세먼지 모드"
                                android:textColor="#111827"
                                android:textSize="14sp"/>

                            <CheckBox
                                android:id="@+id/swDust"
                                android:layout_width="56dp"
                                android:layout_height="32dp"
                                android:button="@null"
                                android:background="@drawable/switch_selector"
                                android:backgroundTint="@null"
                                android:padding="0dp"/>
                        </LinearLayout>

                        <!-- 우천 모드 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="우천 모드"
                                android:textColor="#111827"
                                android:textSize="14sp"/>

                            <CheckBox
                                android:id="@+id/swRain"
                                android:layout_width="56dp"
                                android:layout_height="32dp"
                                android:button="@null"
                                android:background="@drawable/switch_selector"
                                android:backgroundTint="@null"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 네비게이션 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:itemRippleColor="@android:color/transparent"
        app:menu="@menu/menu_bottom_nav"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
