<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:width="36dp"
                android:height="20dp"
                android:gravity="center"
                android:drawable="@drawable/switch_on"/>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:width="36dp"
                android:height="20dp"
                android:gravity="center"
                android:drawable="@drawable/switch_off"/>
        </layer-list>
    </item>
</selector>
